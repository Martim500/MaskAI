# AWS / Bedrock（MaskAgentアプリ専用のIAMユーザーの鍵を指定する）
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Guardrails
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# セッション永続化用DynamoDBテーブル名（省略時は mori-ddb-maskai-prod-sessions）
SESSIONS_TABLE_NAME=mori-ddb-maskai-prod-sessions

# Guardrail管理パネルを表示できる管理者のuser_id（簡易ログイン名）をカンマ区切りで指定
ADMIN_USERS=
